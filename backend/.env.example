# Copy this file to backend/.env and fill in the values below.
# .env is in .gitignore — it will never be committed.

# Supabase project -> Project Settings -> Database -> Connection string -> URI
# (choose "Session pooler" mode; use the password you set when creating the project).
# It looks like:
# postgresql+psycopg://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-xx-xxxx-x.pooler.supabase.com:5432/postgres
DATABASE_URL=

ENVIRONMENT=development

# Google AI Studio -> Get API key -> Create API key (free to start).
# https://aistudio.google.com/apikey
# Without this set, Edin's dream-journal reflections fall back to the
# canned client-side note (see frontend/src/features/dream-journal/dreamUtils.js)
# instead of a real generated one -- the app still works either way.
GEMINI_API_KEY=

# Which Gemini model to call. Deliberately not defaulted in code --
# model names change often enough that a hardcoded default risks
# quietly pointing at a deprecated model. Check the current list at
# https://ai.google.dev/gemini-api/docs/models and pick a "flash" tier
# model (a short reflective note doesn't need the largest model).
GEMINI_MODEL=
