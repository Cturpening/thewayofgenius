# Copy this file to backend/.env and fill in the values below.
# .env is in .gitignore — it will never be committed.

# Supabase project -> Project Settings -> Database -> Connection string -> URI
# (choose "Session pooler" mode; use the password you set when creating the project).
# It looks like:
# postgresql+psycopg://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-xx-xxxx-x.pooler.supabase.com:5432/postgres
DATABASE_URL=

ENVIRONMENT=development

# Which provider is PRIMARY for Edin's generated responses: "gemini" or
# "claude". Whichever one isn't primary is used as an automatic backup
# if it's configured below -- so you don't need both to get started,
# but having both means a primary-provider outage or deprecated model
# falls over to the other one instead of straight to the canned note.
# Switch this to "claude" later (e.g. once you outgrow Gemini's free
# tier) without touching any code.
AI_PROVIDER=gemini

# --- Gemini ---
# Google AI Studio -> Get API key -> Create API key (free to start).
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which Gemini model to call. Deliberately not defaulted in code --
# model names change often enough that a hardcoded default risks
# quietly pointing at a deprecated model. Check the current list at
# https://ai.google.dev/gemini-api/docs/models and pick a "flash" tier
# model (a short reflective note doesn't need the largest model).
GEMINI_MODEL=

# --- Claude (Anthropic API) ---
# This is NOT the same account as a claude.ai chat subscription -- get a
# separate API key (with its own billing) at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Check https://docs.anthropic.com/en/docs/about-claude/models for the
# current model list -- same reasoning as GEMINI_MODEL above, not
# hardcoded on purpose.
ANTHROPIC_MODEL=

# Without ANY of the above set, Edin's dream-journal reflections fall
# back to the canned client-side note (see
# frontend/src/features/dream-journal/dreamUtils.js) instead of a real
# generated one -- the app still works either way.
