# Copy this file to frontend/.env and fill in the values below.
# .env is in .gitignore — it will never be committed.

# Base URL of the FastAPI backend (see backend/README.md).
VITE_API_URL=http://127.0.0.1:8000

# Supabase project -> Project Settings -> API.
# VITE_SUPABASE_URL is the "Project URL". VITE_SUPABASE_ANON_KEY is the
# "anon" / "public" key under Project API keys — safe to ship in the
# frontend bundle. Never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
